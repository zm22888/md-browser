{
  "name": "md-browser",
  "version": "0.1.0",
  "description": "本地 Markdown 浏览器 + 编辑器",
  "main": "out/main/index.js",
  "author": "md-browser",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@mdit/plugin-katex": "^1.2.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dompurify": "^3.4.18",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vditor": "^4.0.1"
  },
  "build": {
    "appId": "com.local.md-browser",
    "productName": "MD Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown 文档",
        "description": "Markdown 文档（MD Browser）",
        "role": "Editor"
      }
    ]
  },
  "allowScripts": {
    "electron@45.4.1": true
  }
}
